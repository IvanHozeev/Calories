    "Тонкий сустав визуально усиливает пик мышцы за счёт контраста, но и потолок обхватов ставит ниже.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفصل النحيف يبرز قمة العضلة بالتباين، لكنه يخفض سقف المحيطات أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schmales Gelenk lässt den Muskelgipfel durch Kontrast stärker wirken, senkt aber auch die Umfangsgrenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A narrow joint makes the muscle peak look sharper by contrast, but it also sets a lower ceiling on girth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una articulación fina realza el pico del músculo por contraste, pero también baja el techo de los contornos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une articulation fine accentue le pic du muscle par contraste, mais abaisse aussi le plafond des tours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפרק צר מבליט את שיא השריר בניגודיות, אך גם מוריד את תקרת ההיקפים."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma articulação fina realça o pico do músculo por contraste, mas também baixa o teto das circunferências."
          }
        }
      }
    },
