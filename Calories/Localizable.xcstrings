    "Пока недостаточно данных — взвешивайся регулярно хотя бы неделю, чтобы увидеть фактический темп.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال البيانات غير كافية — زن نفسك بانتظام لمدة أسبوع على الأقل لرؤية الوتيرة الفعلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genug Daten — wiegen Sie sich mindestens eine Woche regelmäßig, um das tatsächliche Tempo zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data yet — weigh yourself regularly for at least a week to see your actual pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes datos — pésate regularmente al menos una semana para ver el ritmo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de données — pesez-vous régulièrement pendant au moins une semaine pour voir le rythme réel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין מספיק נתונים — שקול את עצמך באופן קבוע לפחות שבוע כדי לראות את הקצב בפועל."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dados suficientes — pese-se regularmente por pelo menos uma semana para ver o ritmo real."
          }
        }
      }
    },
