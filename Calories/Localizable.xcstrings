    "В %@ калорий больше, в остальные дни — меньше. Среднее за неделю остаётся тем же.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %@ سعرات أكثر، في الأيام الأخرى — أقل. يبقى المتوسط الأسبوعي كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %@ gibt es mehr Kalorien, an anderen Tagen — weniger. Der Wochendurchschnitt bleibt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %@ you have more calories, on other days — less. The weekly average stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@ hay más calorías, los demás días — menos. El promedio semanal se mantiene igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@ il y a plus de calories, les autres jours — moins. La moyenne hebdomadaire reste la même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%@ יש יותר קלוריות, ביתר הימים — פחות. הממוצע השבועי נשאר זהה."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %@ há mais calorias, nos outros dias — menos. A média semanal permanece a mesma."
          }
        }
      }
    },
