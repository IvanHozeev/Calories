    "Нет данных о шагах. Если ты не разрешил доступ, включи его в «Здоровье» → «Доступ» → Calories.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد بيانات خطوات. إذا لم تمنح الإذن، فعّله في «الصحة» ← «المشاركة» ← Calories."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Schrittdaten. Falls du keinen Zugriff erlaubt hast, aktiviere ihn in Health → Freigabe → Calories."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No step data. If you did not grant access, enable it in Health → Sharing → Calories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin datos de pasos. Si no diste acceso, actívalo en Salud → Compartir → Calories."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée de pas. Si tu n'as pas donné l'accès, active-le dans Santé → Partage → Calories."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין נתוני צעדים. אם לא אישרת גישה, הפעל אותה ב״בריאות״ ← ״שיתוף״ ← Calories."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem dados de passos. Se você não concedeu acesso, ative em Saúde → Compartilhamento → Calories."
          }
        }
      }
    },
