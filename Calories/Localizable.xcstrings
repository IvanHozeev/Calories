    "Пупок сильно шире узкой талии — типичный признак висцерального жира. Индикатор, а не диагноз.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أن تكون السرة أعرض بكثير من الخصر الضيق علامة نمطية على الدهون الحشوية. مؤشر لا تشخيص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nabelumfang deutlich über der schmalen Taille ist ein typisches Zeichen für viszerales Fett. Ein Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A navel much wider than the narrow waist is a typical sign of visceral fat. An indicator, not a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ombligo mucho más ancho que la cintura estrecha es señal típica de grasa visceral. Un indicador, no un diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombril bien plus large que la taille fine est un signe typique de graisse viscérale. Un indicateur, pas un diagnostic."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טבור רחב בהרבה מהמותן הצר הוא סימן אופייני לשומן ויסצרלי. אינדיקטור, לא אבחנה."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um umbigo bem mais largo que a cintura estreita é sinal típico de gordura visceral. Um indicador, não um diagnóstico."
          }
        }
      }
    },
