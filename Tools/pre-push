#!/bin/bash
#
# Не пускать красное в репозиторий.
#
# Единственная защита, которая у этого проекта есть на самом деле: CI на
# чужих раннерах при здешнем темпе съедает бесплатную квоту за сутки, а
# «я прогоню перед пушем» работает ровно до того дня, когда забудешь.
#
# Ставится ссылкой, чтобы правки скрипта доезжали сами:
#   ln -sf ../../Tools/pre-push .git/hooks/pre-push
#
# Чинишь сам прогон — пушь с --no-verify: красный набор тогда и есть то,
# что чинится.
#
# Путь берём у git, а не у $BASH_SOURCE: хук лежит симлинком в .git/hooks,
# и относительный путь от него ведёт в .git, а не в корень.
ROOT="$(git rev-parse --show-toplevel)"

echo "▸ Прогоняю набор перед пушем. --no-verify, если чинишь его сам."
"$ROOT/Tools/test.sh" || {
    echo
    echo "✘ Пуш отменён: набор красный."
    exit 1
}
