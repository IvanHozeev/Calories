    "130 г/день — RDA, минимум глюкозы для работы мозга, не зависит от веса.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "130 جم/يوم — الحد الأدنى من الجلوكوز لعمل الدماغ، لا يعتمد على الوزن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "130 g/Tag — RDA, Mindestglukose für das Gehirn, unabhängig vom Gewicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "130 g/day — RDA minimum glucose for brain function, not weight-dependent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "130 g/día — RDA, mínimo de glucosa para el cerebro, no depende del peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "130 g/jour — AJR, minimum de glucose pour le cerveau, indépendant du poids."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "130 ג'/יום — RDA, מינימום גלוקוז לפעילות המוח, לא תלוי במשקל."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "130 g/dia — RDA, mínimo de glicose para o cérebro, não depende do peso."
          }
        }
      }
    },
    "14 дней подряд в пределах дневной нормы калорий.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "14 يومًا متتاليًا ضمن هدفك اليومي من السعرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "14 Tage in Folge innerhalb deines täglichen Kalorienziels."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14 days in a row within your daily calorie target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "14 días seguidos dentro de tu objetivo diario de calorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 jours d'affilée dans ton objectif calorique quotidien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ימים ברציפות בתוך יעד הקלוריות היומי."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dias seguidos dentro da sua meta diária de calorias."
          }
        }
      }
    },
