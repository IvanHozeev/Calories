    "Поставь целевой вес и срок — дневная норма пересчитается под них.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد وزنًا مستهدفًا ومدة، وسيُعاد حساب هدفك اليومي وفقًا لهما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Zielgewicht und Zeitraum fest – dein Tagesziel wird entsprechend neu berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a goal weight and a timeframe — your daily target is recalculated to match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define un peso objetivo y un plazo: tu objetivo diario se recalculará en consecuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe un poids cible et un délai : ton objectif quotidien sera recalculé en conséquence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבע משקל יעד ותקופה — היעד היומי יחושב מחדש בהתאם."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um peso-alvo e um prazo — sua meta diária será recalculada de acordo."
          }
        }
      }
    },
