    "Одинаковая норма каждый день. Включи цикл, если хочешь распределить калории по дням недели с рефид-днями.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفس الهدف كل يوم. فعّل الدورة إذا أردت توزيع السعرات على أيام الأسبوع مع أيام إعادة التغذية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Ziel jeden Tag. Aktivieren Sie den Zyklus, um Kalorien auf Wochentage mit Refeed-Tagen zu verteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same goal every day. Enable the cycle to distribute calories across the week with refeed days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma meta cada día. Activa el ciclo para distribuir calorías a lo largo de la semana con días de recarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même objectif chaque jour. Activez le cycle pour répartir les calories sur les jours de la semaine avec des jours de recharge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יעד זהה כל יום. הפעל מחזור אם ברצונך לחלק קלוריות לפי ימי השבוע עם ימי רפיד."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma meta todos os dias. Ative o ciclo para distribuir calorias pelos dias da semana com dias de recarga."
          }
        }
      }
    },
