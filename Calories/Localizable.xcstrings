    "Рука согнута, напряжена, но без предварительного пампа. По пику бицепса.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذراع مثنية ومشدودة دون إحماء مسبق. عند قمة العضلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm gebeugt und angespannt, aber ohne vorherigen Pump. Am Bizepsgipfel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm bent and flexed, but with no pump beforehand. At the peak of the biceps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazo flexionado y en tensión, pero sin bombeo previo. Por el pico del bíceps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras plié et contracté, mais sans congestion préalable. Au pic du biceps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היד כפופה ומכווצת, בלי פאמפ מוקדם. בשיא הביצפס."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Braço dobrado e contraído, mas sem pump prévio. No pico do bíceps."
          }
        }
      }
    },
