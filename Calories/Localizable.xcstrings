          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel wird %d kcal statt %d – also %@%d kcal pro Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target becomes %d kcal instead of %d — that is %@%d kcal a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo pasa a %d kcal en vez de %d: son %@%d kcal al día."
