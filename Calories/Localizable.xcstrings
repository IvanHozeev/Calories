    "Замедлить: при %lld ккал/день придёшь к %@ кг к %@.": {
      "comment": "A label offering to slow down the plan by adjusting the daily calorie goal, along with a button to do so. The first argument is the recalibrated daily calorie goal. The second argument is the string “%.1f”. The third argument is the formatted date when the plan is supposed to end.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow down: at %1$lld kcal/day you'll reach %2$@ kg by %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замедлить: при %1$lld ккал/день придёшь к %2$@ кг к %3$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האט: עם %1$lld קק\"ל/יום תגיע ל-%2$@ ק\"ג עד %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir: con %1$lld kcal/día llegarás a %2$@ kg para %3$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تباطأ: مع %1$lld سعرة/يوم ستصل إلى %2$@ كجم بحلول %3$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desacelerar: com %1$lld kcal/dia você chegará a %2$@ kg até %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralentir : avec %1$lld kcal/jour vous atteindrez %2$@ kg d'ici %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlangsamen: Mit %1$lld kcal/Tag erreichen Sie %2$@ kg bis %3$@."
          }
        }
      }
    },
