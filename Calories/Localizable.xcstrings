    "Левая и правая стороны — отдельно, по ним считается симметрия.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدخل الجانبان الأيسر والأيمن كلٌّ على حدة، ومنهما يُحسب التناظر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links und rechts werden getrennt eingetragen – daraus ergibt sich die Symmetrie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left and right are entered separately — symmetry is worked out from them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Izquierda y derecha se introducen por separado: de ahí se calcula la simetría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gauche et droite se saisissent séparément : c'est de là que vient la symétrie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמאל וימין מוזנים בנפרד — מהם מחושבת הסימטריה."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquerda e direita são inseridas separadamente: daí se calcula a simetria."
          }
        }
      }
    },
