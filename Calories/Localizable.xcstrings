    "Сначала сохрани профиль — план считается по твоим BMR/TDEE.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ ملفك الشخصي أولاً — تُحسب الخطة وفق BMR/TDEE الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil zuerst speichern — der Plan wird mit Ihrem BMR/TDEE berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your profile first — the plan is calculated from your BMR/TDEE."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda primero tu perfil — el plan se calcula con tu BMR/TDEE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez d'abord le profil — le plan est calculé avec votre BMR/TDEE."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור קודם את הפרופיל — התוכנית מחושבת לפי BMR/TDEE שלך."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o perfil primeiro — o plano é calculado com seu BMR/TDEE."
          }
        }
      }
    },
