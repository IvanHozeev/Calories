    "Чтобы увидеть цель, заполни профиль.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in your profile to see your goal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מלא את הפרופיל כדי לראות את היעד."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa tu perfil para ver la meta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل ملفك الشخصي لرؤية الهدف."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha o perfil para ver a meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissez le profil pour voir l'objectif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil ausfüllen, um das Ziel zu sehen."
          }
        }
      }
    },
    "Чтобы увидеть цель, укажи вес — в профиле или на экране «Вес».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specify your weight in the profile or on the Weight screen to see your goal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ציין משקל — בפרופיל או במסך 'משקל' — כדי לראות את היעד."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica tu peso — en el perfil o en la pantalla 'Peso' — para ver la meta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد وزنك — في الملف الشخصي أو شاشة 'الوزن' — لرؤية الهدف."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique seu peso — no perfil ou na tela 'Peso' — para ver a meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez votre poids — dans le profil ou l'écran 'Poids' — pour voir l'objectif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihr Gewicht an — im Profil oder im Gewicht-Bildschirm — um das Ziel zu sehen."
          }
        }
      }
    },
