    "Макросы за день и насколько закрыты нормы.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مغذيات اليوم الكبرى ومدى تحقّق الأهداف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Makros des Tages und wie weit die Ziele erreicht sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day's macros and how far the targets are met."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los macros del día y cuánto se cubren las metas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les macros du jour et l'avancement des objectifs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאקרו של היום וכמה מהיעדים הושלמו."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os macros do dia e o quanto as metas estão cobertas."
          }
        }
      }
    },
    "Один жест до еды, камеры, сканера или замеров. Что именно — выбирается в правке Пункта управления.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمسة واحدة إلى الطعام أو الكاميرا أو الماسح أو القياسات. وأيّها يُختار أثناء تحرير مركز التحكم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Geste bis zum Essen, zur Kamera, zum Scanner oder zu den Maßen. Welche davon, wird beim Bearbeiten des Kontrollzentrums gewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One gesture to food, the camera, the scanner or measurements. Which one is chosen while editing Control Centre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gesto hasta la comida, la cámara, el escáner o las medidas. Cuál se elige al editar el Centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un geste jusqu'à la nourriture, l'appareil photo, le scanner ou les mesures. Lequel se choisit en modifiant le centre de contrôle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחווה אחת עד לאוכל, למצלמה, לסורק או למדידות. מה בדיוק — נבחר בעריכת מרכז הבקרה."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gesto até a comida, a câmera, o scanner ou as medidas. Qual delas se escolhe ao editar a Central de Controle."
          }
        }
      }
    },
