    "Давай настроим твою персональную норму калорий — займёт меньше минуты.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعنا نضبط هدف السعرات الشخصي — سيستغرق أقل من دقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten wir Ihr persönliches Kalorienziel ein — dauert weniger als eine Minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's set up your personal calorie goal — it'll take less than a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuremos tu meta de calorías personalizada — tomará menos de un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurons votre objectif calorique personnel — cela prendra moins d'une minute."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוא נגדיר את יעד הקלוריות האישי שלך — ייקח פחות מדקה."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos configurar sua meta calórica pessoal — levará menos de um minuto."
          }
        }
      }
    },
