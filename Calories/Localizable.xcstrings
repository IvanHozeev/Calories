    "Темп выше ~1% веса в неделю — довольно агрессивно. Можно смягчить, увеличив срок или скорректировав целевой вес.": {
      "comment": "Literal percentage in explanatory text, not a format specifier.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وتيرة أعلى من ~1% من وزن الجسم أسبوعياً — عدواني جداً. يمكن تخفيفه بزيادة المدة أو تعديل الوزن المستهدف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo über ~1% des Körpergewichts pro Woche — ziemlich aggressiv. Abmildern durch Verlängerung der Dauer oder Anpassen des Zielgewichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate above ~1% of body weight per week — quite aggressive. Ease it by increasing the duration or adjusting the target weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo superior al ~1% del peso por semana — bastante agresivo. Puedes suavizarlo aumentando la duración o ajustando el peso objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rythme supérieur à ~1% du poids par semaine — assez agressif. Adoucissez en augmentant la durée ou en ajustant le poids cible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצב מעל ~1% ממשקל הגוף בשבוע — די אגרסיבי. ניתן להפחית על ידי הארכת המשך או התאמת משקל היעד."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo acima de ~1% do peso corporal por semana — bastante agressivo. Pode suavizar aumentando a duração ou ajustando o peso-alvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темп выше ~1% веса в неделю — довольно агрессивно. Можно смягчить, увеличив срок или скорректировав целевой вес."
          }
        }
      }
    },
    "Тонкий сустав": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفصل نحيف"
          }
        },
        "de": {
