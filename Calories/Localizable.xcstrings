    "Спланируй сушку или набор: приложение само посчитает дневную норму калорий под целевой вес и срок.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطّط لمرحلة تنشيف أو زيادة: يحسب التطبيق هدفك اليومي من السعرات وفق الوزن المستهدف والمدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane eine Diät- oder Aufbauphase: Die App berechnet dein tägliches Kalorienziel aus Zielgewicht und Zeitraum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan a cut or a bulk: the app works out your daily calorie target from your goal weight and timeframe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica una definición o un volumen: la app calcula tu objetivo diario de calorías según tu peso objetivo y el plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifie une sèche ou une prise de masse : l'app calcule ton objectif calorique quotidien selon ton poids cible et ton délai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תכנן חיטוב או מסה: האפליקציה תחשב את יעד הקלוריות היומי לפי משקל היעד והתקופה."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje um cutting ou bulking: o app calcula sua meta diária de calorias a partir do peso-alvo e do prazo."
          }
        }
      }
    },
    "Сравни динамику веса с калорийностью выше — если вес не двигается, а цель по калориям — дефицит, стоит перепроверить норму в профиле.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قارن اتجاه الوزن بالسعرات أعلاه — إذا لم يتغير الوزن والهدف عجز، راجع ملفك الشخصي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleichen Sie den Gewichtsverlauf mit den Kalorien oben — wenn das Gewicht stagniert und das Ziel ein Defizit ist, das Profil überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare weight dynamics with the calories above — if weight isn't moving despite a calorie deficit, double-check your profile settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la tendencia de peso con las calorías de arriba — si el peso no cambia pero la meta es déficit, revisa tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez la tendance du poids avec les calories ci-dessus — si le poids ne bouge pas et l'objectif est un déficit, revérifiez le profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השווה את מגמת המשקל עם הקלוריות למעלה — אם המשקל לא זז אבל היעד הוא גירעון, כדאי לבדוק מחדש את היעד בפרופיל."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare a tendência de peso com as calorias acima — se o peso não mudar e a meta for déficit, revise o perfil."
          }
        }
      }
    },
