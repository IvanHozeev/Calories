    "На этой неделе был перерасход — норма сегодня снижена.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You overate this week — today's goal is reduced."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היה חריגה השבוע — היעד היומי הופחת."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excediste las calorías esta semana — la meta de hoy se ha reducido."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت السعرات هذا الأسبوع — تم تخفيض الهدف اليومي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você excedeu as calorias esta semana — a meta de hoje foi reduzida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez dépassé les calories cette semaine — l'objectif d'aujourd'hui est réduit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Woche überschritten — das heutige Ziel wurde reduziert."
          }
        }
      }
    },
    "На этой неделе ты сэкономил калории — они распределены по оставшимся дням.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You saved calories this week — they're spread across the remaining days."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסכת קלוריות השבוע — הן מחולקות על שאר הימים."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorraste calorías esta semana — están distribuidas en los días restantes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وفّرت سعرات هذا الأسبوع — موزعة على الأيام المتبقية."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você economizou calorias esta semana — distribuídas nos dias restantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez économisé des calories cette semaine — réparties sur les jours restants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben diese Woche Kalorien gespart — auf die verbleibenden Tage verteilt."
          }
        }
      }
    },
