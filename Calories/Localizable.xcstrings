    "Дневная цель вернётся к расчёту по профилю. Записи о еде и весе останутся на месте.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعود هدفك اليومي إلى الحساب المعتمد على الملف الشخصي. تبقى سجلات الطعام والوزن كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tagesziel kehrt zur Berechnung anhand des Profils zurück. Einträge zu Essen und Gewicht bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily target goes back to the profile-based calculation. Food and weight entries stay untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu objetivo diario volverá al cálculo basado en el perfil. Los registros de comida y peso no se verán afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton objectif quotidien reviendra au calcul basé sur le profil. Tes entrées de repas et de poids restent intactes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היעד היומי יחזור לחישוב לפי הפרופיל. רישומי המזון והמשקל יישארו במקומם."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua meta diária voltará ao cálculo baseado no perfil. Os registros de comida e peso permanecerão intactos."
          }
        }
      }
    },
