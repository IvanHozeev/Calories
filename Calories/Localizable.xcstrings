          }
        }
      }
    },
    "В самом узком месте, обычно на ладонь выше пупка. Живот не втягивать, дышать спокойно.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند أضيق نقطة، عادةً بمقدار كف فوق السرة. لا تشفط البطن وتنفّس بهدوء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der schmalsten Stelle, meist eine Handbreit über dem Nabel. Bauch nicht einziehen, ruhig atmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the narrowest point, usually a hand above the navel. Do not suck in, breathe normally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el punto más estrecho, normalmente una mano por encima del ombligo. Sin meter tripa, respira con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au point le plus étroit, en général une main au-dessus du nombril. Ne rentre pas le ventre, respire normalement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בנקודה הצרה ביותר, בדרך כלל כף יד מעל הטבור. בלי לשאוב את הבטן, נשום רגיל."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No ponto mais estreito, normalmente uma mão acima do umbigo. Sem contrair, respire normalmente."
          }
        }
      }
    },
    "В самом широком месте ниже локтя, кулак сжат, рука вытянута.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند أعرض نقطة أسفل المرفق، القبضة مضمومة والذراع ممدودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der breitesten Stelle unter dem Ellbogen, Faust geballt, Arm gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the widest point below the elbow, fist clenched, arm extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el punto más ancho debajo del codo, puño cerrado, brazo extendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au point le plus large sous le coude, poing serré, bras tendu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בנקודה הרחבה ביותר מתחת למרפק, אגרוף קפוץ והיד מיושרת."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No ponto mais largo abaixo do cotovelo, punho fechado, braço estendido."
          }
        }
      }
    },
