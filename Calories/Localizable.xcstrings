    "В классическом бодибилдинге эти три обхвата держат равными. Отстающее звено обычно икра.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في كمال الأجسام الكلاسيكي تُبقى هذه الثلاثة متساوية، والمتأخر عادةً هو بطة الساق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im klassischen Bodybuilding hält man diese drei gleich. Der Nachzügler ist meist die Wade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classic bodybuilding keeps these three equal. The lagging one is usually the calf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El culturismo clásico mantiene estas tres medidas iguales. La rezagada suele ser la pantorrilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bodybuilding classique garde ces trois mesures égales. Le retard vient généralement du mollet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בפיתוח גוף קלאסי שומרים על שלושת המידות שוות. הפיגור בדרך כלל בשוק."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fisiculturismo clássico mantém as três iguais. A atrasada costuma ser a panturrilha."
          }
        }
      }
    },
