    "Углубить цель: при текущем темпе к %@ ты можешь достичь %@ кг.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepen goal: at your current pace by %1$@ you can reach %2$@ kg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Углубить цель: при текущем темпе к %1$@ ты можешь достичь %2$@ кг."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמיק יעד: בקצב הנוכחי עד %1$@ תוכל להגיע ל-%2$@ ק\"ג."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundizar meta: al ritmo actual para %1$@ puedes alcanzar %2$@ kg."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمّق الهدف: بالوتيرة الحالية بحلول %1$@ يمكنك الوصول إلى %2$@ كجم."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprofundar meta: no ritmo atual até %1$@ você pode atingir %2$@ kg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approfondir l'objectif : au rythme actuel d'ici %1$@ vous pouvez atteindre %2$@ kg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel vertiefen: Beim aktuellen Tempo bis %1$@ können Sie %2$@ kg erreichen."
          }
        }
      }
    },
