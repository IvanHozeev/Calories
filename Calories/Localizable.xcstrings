        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היעד יהיה %d קלוריות במקום %d — כלומר %@%d ליום."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A meta passa a %d kcal em vez de %d: são %@%d kcal por dia."
