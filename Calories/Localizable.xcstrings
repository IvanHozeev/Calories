    "Взято из профиля — стоит записать актуальный вес на экране «Вес».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken from your profile — consider logging your current weight on the Weight screen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נלקח מהפרופיל — כדאי לרשום משקל עדכני במסך 'משקל'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomado del perfil — considera registrar tu peso actual en la pantalla 'Peso'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مأخوذ من الملف الشخصي — يُنصح بتسجيل وزنك الحالي في شاشة 'الوزن'."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirado do perfil — vale registrar o peso atual na tela 'Peso'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiré du profil — pensez à enregistrer votre poids actuel dans l'écran 'Poids'."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Profil — tragen Sie Ihr aktuelles Gewicht im Gewicht-Bildschirm ein."
          }
        }
      }
    },
    "Включи, чтобы получать напоминания записывать приёмы пищи.": {
