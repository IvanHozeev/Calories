    "Норма станет %d ккал вместо %d — это %@%d ккал в день.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصبح الهدف %d سعرة بدلًا من %d، أي %@%d سعرة يوميًا."
          }
        },
