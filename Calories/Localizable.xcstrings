    "Слева/справа и расхождение. До 1 см — погрешность ленты, свыше 2 см стоит смотреть.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسار/يمين والفارق. أقل من 1 سم خطأ قياس، وأكثر من 2 سم يستحق الانتباه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links/rechts und die Differenz. Unter 1 cm ist Messfehler, über 2 cm lohnt ein Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left/right and the gap. Under 1 cm is tape error; over 2 cm is worth a look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Izquierda/derecha y la diferencia. Menos de 1 cm es error de cinta; más de 2 cm merece atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gauche/droite et l'écart. Moins d'1 cm, c'est l'erreur du mètre ; au-delà de 2 cm, ça mérite un œil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמאל/ימין והפער. פחות מ-1 ס״מ הוא טעות מדידה, מעל 2 ס״מ שווה בדיקה."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquerda/direita e a diferença. Menos de 1 cm é erro da fita; mais de 2 cm merece atenção."
          }
        }
      }
    },
