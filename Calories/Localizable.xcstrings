    "Ориентир 79–82%. Предплечье даёт руке плотность — без него бицепс выглядит приклеенным.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدى المستهدف 79–82%. الساعد يمنح الذراع كثافة، وبدونه تبدو العضلة ملصقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielbereich 79–82%. Der Unterarm gibt dem Arm Dichte – ohne ihn wirkt der Bizeps aufgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for 79–82%. The forearm gives the arm density — without it the biceps looks stuck on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo 79–82%. El antebrazo da densidad al brazo; sin él el bíceps parece pegado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vise 79–82%. L'avant-bras donne de la densité au bras ; sans lui le biceps semble rapporté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היעד 79–82%. האמה נותנת לזרוע צפיפות — בלעדיה הביצפס נראה מודבק."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alvo 79–82%. O antebraço dá densidade ao braço; sem ele o bíceps parece colado."
          }
        }
      }
    },
