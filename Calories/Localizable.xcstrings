    "Верхняя треть, под ягодичной складкой. Вес на обеих ногах поровну.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الثلث العلوي أسفل ثنية الأرداف مباشرة. الوزن موزّع على الساقين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberes Drittel, direkt unter der Gesäßfalte. Gewicht gleichmäßig auf beiden Beinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper third, just under the glute fold. Weight evenly on both legs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercio superior, justo bajo el pliegue glúteo. Peso repartido en ambas piernas."
          }
        },
        "fr": {
          "stringUnit": {
