    "≥0.8 г/кг — принятый минимум для гормонального здоровья.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "≥0.8 g/kg — the accepted minimum for hormonal health."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "≥0.8 ג'/ק\"ג — המינימום המקובל לבריאות הורמונלית."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "≥0.8 g/kg — el mínimo aceptado para la salud hormonal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "≥0.8 جم/كجم — الحد الأدنى المقبول للصحة الهرمونية."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "≥0.8 g/kg — o mínimo aceito para a saúde hormonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "≥0.8 g/kg — le minimum accepté pour la santé hormonale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "≥0.8 g/kg — das akzeptierte Minimum für die Hormongesundheit."
          }
        }
      }
    },
