    "При включённом цикле замедлить темп можно через увеличение целевого веса или срока — расчёт (%lld ккал/день в среднем) пересчитается автоматически.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the cycle on, slow down by increasing the target weight or duration — the calculation (%lld kcal/day average) will update automatically."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם מחזור מופעל, ניתן להאט את הקצב על ידי הגדלת משקל היעד או משך הזמן — החישוב (%lld קק\"ל/יום בממוצע) יתעדכן אוטומטית."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el ciclo activo, reduce el ritmo aumentando el peso objetivo o la duración — el cálculo (%lld kcal/día en promedio) se actualizará automáticamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تفعيل الدورة، خفّف الوتيرة بزيادة الوزن المستهدف أو المدة — سيتم تحديث الحساب (%lld سعرة/يوم متوسط) تلقائياً."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o ciclo ativo, reduza o ritmo aumentando o peso-alvo ou a duração — o cálculo (%lld kcal/dia em média) será atualizado automaticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le cycle activé, ralentissez en augmentant le poids cible ou la durée — le calcul (%lld kcal/jour en moyenne) se mettra à jour automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit aktivem Zyklus das Tempo verringern, indem Zielgewicht oder Dauer erhöht wird — die Berechnung (%lld kcal/Tag im Durchschnitt) wird automatisch aktualisiert."
          }
        }
      }
    },
    "При включённом цикле точную корректировку стоит вносить через целевой вес/срок — расчёт (%lld ккал/день в среднем) учтёт её автоматически.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the cycle on, make precise adjustments via target weight/duration — the calculation (%lld kcal/day average) will account for it automatically."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם מחזור מופעל, כדאי לבצע התאמות מדויקות דרך משקל/משך היעד — החישוב (%lld קק\"ל/יום בממוצע) יביא זאת בחשבון אוטומטית."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el ciclo activo, haz ajustes precisos mediante el peso/duración objetivo — el cálculo (%lld kcal/día en promedio) lo tendrá en cuenta automáticamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تفعيل الدورة، أجرِ تعديلات دقيقة عبر الوزن/المدة المستهدفة — سيأخذها الحساب (%lld سعرة/يوم متوسط) في الاعتبار تلقائياً."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o ciclo ativo, faça ajustes precisos pelo peso/duração-alvo — o cálculo (%lld kcal/dia em média) os considerará automaticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le cycle activé, faites des ajustements précis via le poids/durée cible — le calcul (%lld kcal/jour en moyenne) en tiendra compte automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit aktivem Zyklus genaue Korrekturen über Zielgewicht/-dauer vornehmen — die Berechnung (%lld kcal/Tag im Durchschnitt) berücksichtigt sie automatisch."
          }
        }
      }
    },
    "При текущем темпе цель — к": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At current pace, goal — by"
