    "Меряй утром натощак сантиметровой лентой. Талия — на уровне пупка, шея — под кадыком.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قس في الصباح على معدة فارغة بشريط قياس. الخصر — عند مستوى السرة، الرقبة — تحت تفاحة آدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messen Sie morgens nüchtern mit einem Maßband. Taille — auf Nabelhöhe, Hals — unterhalb des Adamsapfels."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure in the morning on an empty stomach. Waist — at navel level, neck — below the Adam's apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide por la mañana en ayunas con cinta métrica. Cintura — a la altura del ombligo, cuello — bajo la nuez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez le matin à jeun avec un mètre ruban. Taille — au niveau du nombril, cou — sous la pomme d'Adam."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדוד בבוקר על קיבה ריקה עם סרט מידה. מותן — בגובה הטבור, צוואר — מתחת לגרגרת."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça de manhã em jejum com fita métrica. Cintura — na altura do umbigo, pescoço — abaixo do pomo de adão."
          }
        }
      }
    },
    "Месяц": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهر"
          }
        },
